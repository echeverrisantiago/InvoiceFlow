// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums
enum Role {
  ADMIN
  MEMBER
}

enum SubscriptionPlan {
  STARTER
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

enum InvoiceStatus {
  PROCESSING
  EXTRACTED
  BACKED_UP
  FAILED
  PAID
  PENDING
  OVERDUE
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum EmailProvider {
  GMAIL
  OUTLOOK
}

enum InvoiceSource {
  MANUAL
  EMAIL
}

// Models
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Supabase Auth ID
  authId String @unique

  // Relations
  memberships      OrganizationMember[]
  uploadedInvoices Invoice[]           @relation("InvoiceUploadedBy")

  @@index([authId])
  @@index([email])
  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Google Drive integration
  driveRefreshToken String?  @db.Text
  driveTokenExpiry  DateTime?

  // OneDrive integration
  onedriveRefreshToken String? @db.Text
  onedriveTokenExpiry  DateTime?

  // Relations
  members       OrganizationMember[]
  invoices      Invoice[]
  subscription  Subscription?
  alertLogs     AlertLog[]
  emailAccounts EmailAccount[]

  @@map("organizations")
}

model OrganizationMember {
  id        String   @id @default(cuid())
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model Invoice {
  id            String        @id @default(cuid())
  source        InvoiceSource @default(MANUAL)
  status        InvoiceStatus @default(PROCESSING)
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // File information
  fileName String
  fileUrl  String
  fileSize Int?

  // Email source (preview fetched live from the inbox when set)
  emailAccountId     String?
  messageUid         BigInt?
  attachmentFilename String?

  // Google Drive backup
  driveFileId String?

  // Extracted data
  supplier      String?
  supplierNit   String?
  issueDate     DateTime?
  dueDate       DateTime?
  subtotal      Float?
  iva           Float?
  total         Float?
  description   String? @db.Text
  internalNotes String? @db.Text
  invoiceItems  Json?
  extractedData Json?   // Raw AI response

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedById   String?
  uploadedBy     User?        @relation("InvoiceUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  emailAccount   EmailAccount? @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([emailAccountId])
  @@index([issueDate])
  @@index([dueDate])
  @@index([status])
  @@index([paymentStatus])
  @@index([supplier])
  @@map("invoices")
}

model EmailAccount {
  id             String         @id @default(cuid())
  email          String
  provider       EmailProvider

  // OAuth fields (GMAIL or OUTLOOK)
  oauthRefreshToken String?     @db.Text
  oauthAccessToken  String?     @db.Text
  oauthTokenExpiry  DateTime?

  isActive       Boolean        @default(true)
  lastCheckedAt  DateTime?
  lastEmailUid   BigInt?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invoices Invoice[]

  @@index([organizationId])
  @@index([email])
  @@map("email_accounts")
}

model Subscription {
  id        String             @id @default(cuid())
  plan      SubscriptionPlan   @default(STARTER)
  status    SubscriptionStatus @default(TRIALING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // Mercado Pago
  mercadoPagoSubscriptionId String?  @unique
  mercadoPagoCustomerId     String?

  // Billing period
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  // Relations
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model AlertLog {
  id        String   @id @default(cuid())
  type      String   // 'due_date', 'extraction_failed', etc.
  message   String   @db.Text
  sentAt    DateTime @default(now())
  metadata  Json?

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
  @@index([sentAt])
  @@map("alert_logs")
}
