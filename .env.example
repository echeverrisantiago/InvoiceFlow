# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Groq AI
GROQ_API_KEY=your_groq_api_key
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@invoiceflow.app

# Google Drive API
GOOGLE_DRIVE_CLIENT_ID=your_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_client_secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/auth/google-drive/callback

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=your_mp_access_token
MERCADOPAGO_PUBLIC_KEY=your_mp_public_key
# Secret de webhooks (Tus integraciones > Webhooks). Si está vacío no se valida la firma.
MERCADOPAGO_WEBHOOK_SECRET=44c81cd52fee0da34224f80fb15c401540393172cc792fb405b21da09cde56dc

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your_random_secret_for_cron

# Gmail OAuth (for email invoice fetching)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/email/gmail/callback

# Outlook OAuth (for email invoice fetching + OneDrive storage)
OUTLOOK_CLIENT_ID=your_outlook_client_id
OUTLOOK_CLIENT_SECRET=your_outlook_client_secret
OUTLOOK_TENANT_ID=common
OUTLOOK_REDIRECT_URI=http://localhost:3000/api/auth/email/outlook/callback
OUTLOOK_ONEDRIVE_REDIRECT_URI=http://localhost:3000/api/auth/onedrive/callback

# Upstash Redis (for rate limiting)
# Si se dejan los valores de ejemplo, el rate limiting queda desactivado (fail-open).
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
